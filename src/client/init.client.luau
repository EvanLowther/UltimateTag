--!strict
-- Client entry point. Requires each client module and starts it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local AirStrafe = require(script.AirStrafe)
local FaceCamera = require(script.FaceCamera)
local FirstPersonBody = require(script.FirstPersonBody)
local Hud = require(script.Hud)
local Mantle = require(script.Mantle)
local Slide = require(script.Slide)
local Sprint = require(script.Sprint)
local Upright = require(script.Upright)
local Vault = require(script.Vault)
local ViewMode = require(script.ViewMode)
local Viewmodel = require(script.Viewmodel)
local WallBounce = require(script.WallBounce)
local WallRun = require(script.WallRun)

Hud.start()
Upright.start()
Sprint.start()
Slide.start()
Vault.start()
Mantle.start()
WallRun.start()
WallBounce.start()
AirStrafe.start()
ViewMode.start()
FaceCamera.start()
FirstPersonBody.start()
Viewmodel.start()

print(`[{Config.GameName}] client started (v{Config.Version})`)
