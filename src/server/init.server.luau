local Remotes = require(Shared:WaitForChild("Remotes"))

local Achievements = require(script.Achievements)
local Avatar = require(script.Avatar)
local GameLoop = require(script.GameLoop)
local GameRewards = require(script.GameRewards)
local CollisionGroups = require(script.CollisionGroups)
local DailyStreak = require(script.DailyStreak)
local Cosmetics = require(script.Cosmetics)
local DevCommands = require(script.DevCommands)
local Leaderboards = require(script.Leaderboards)
local Leaderstats = require(script.Leaderstats)
local LobbyBoards = require(script.LobbyBoards)
local MapRespawn = require(script.MapRespawn)
local PlayerData = require(script.PlayerData)
local Purchases = require(script.Purchases)
local Quests = require(script.Quests)
local Progression = require(script.Progression)
local RewardWheel = require(script.RewardWheel)
local Shop = require(script.Shop)
local Roles = require(script.Roles)
local Spectators = require(script.Spectators)
local TagService = require(script.TagService)
local Trains = require(script.Trains)
local PopUps = require(script.PopUps)
local WinsStore = require(script.WinsStore)

Remotes.setup()
PlayerData.start()
Progression.start()
Cosmetics.start()
Shop.start()
DailyStreak.start()
Quests.start()
Achievements.start()
Purchases.start()
Avatar.start()
CollisionGroups.start()
Leaderstats.start()
WinsStore.start()
Leaderboards.start()
LobbyBoards.start()
RewardWheel.start()
Roles.start()
Spectators.start()
GameRewards.start()
TagService.start()
GameLoop.start()
MapRespawn.start()
