--!strict
-- Studio tool: builds the grey-box of the Tag Island Port map from PortData (generated by
-- tools/port_layout.py) as ServerStorage.Maps.TagIslandPort. Run it in the Command Bar:
--        require(game.ServerStorage.Tools.BuildPortGreybox)()
-- Plain bright blocks sized for the moves (containers 8 tall, vault props 2.5-3.5, a slide-under
-- container on crates), 8 spawn points, an invisible wall around the edge and ocean beyond it.
-- Then playtest it from the dev panel (Maps tab > Play). Running it again replaces the map, so
-- hand edits are lost: to edit by hand, drag the map into Workspace, change it, and drag it back.
-- Ctrl+Z undoes it.
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local ServerStorage = game:GetService("ServerStorage")

local Data = require(script.Parent.PortData) :: any

local WALL_HEIGHT = 60 -- invisible boundary walls
local OCEAN_SIZE = 1000
local OCEAN_COLOR = Color3.fromRGB(40, 170, 210)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

local function folder(parent: Instance, name: string, className: string?): Instance
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local f = Instance.new(className or "Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function addPart(map: Model, info: any)
	local group = folder(map, info.Group)
	local p = part({
		Name = info.Name,
		Size = info.Size,
		Color = info.Color,
		CanCollide = info.Collide ~= false,
	})
	local cframe = CFrame.new(info.Position)
	if info.Shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
		if info.Upright then
			-- A cylinder's length runs along X: stand it up, and swap the size to match.
			p.Size = Vector3.new(info.Size.Y, info.Size.X, info.Size.Z)
			cframe *= CFrame.Angles(0, 0, math.rad(90))
		end
	end
	p.CFrame = cframe
	if info.Invisible then
		p.Transparency = 1
		p.CastShadow = false
	end
	if info.SlideBlocker then
		p:SetAttribute("SlideBlocker", true)
	end
	if info.Glow then
		p.Material = Enum.Material.Neon
		p.CastShadow = false
	end
	p.Parent = group
end

local function addBoundary(map: Model, half: number)
	local edge = folder(map, "Boundary")
	local thickness = 2
	for i, side in { Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis } do
		local along = if side.X ~= 0
			then Vector3.new(thickness, WALL_HEIGHT, half * 2 + 4)
			else Vector3.new(half * 2 + 4, WALL_HEIGHT, thickness)
		part({
			Name = `Wall{i}`,
			Size = along,
			CFrame = CFrame.new(side * (half + thickness / 2) + Vector3.new(0, WALL_HEIGHT / 2, 0)),
			Transparency = 1,
			CastShadow = false,
			Parent = edge,
		})
	end
	-- Ocean around the yard (decoration only).
	part({
		Name = "Ocean",
		Size = Vector3.new(OCEAN_SIZE, 1, OCEAN_SIZE),
		CFrame = CFrame.new(0, -3, 0),
		Color = OCEAN_COLOR,
		Transparency = 0.15,
		Reflectance = 0.05,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Parent = edge,
	})
end

local function addSpawns(map: Model)
	local spawns = folder(map, "Spawns")
	for i, position in Data.Spawns do
		part({
			Name = `Spawn{i}`,
			Size = Vector3.new(2, 1, 2),
			CFrame = CFrame.lookAt(position, Vector3.new(0, position.Y, 0)), -- facing the middle
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Parent = spawns,
		})
	end
end

return function()
	local maps = ServerStorage:FindFirstChild("Maps")
	if not maps then
		warn("[BuildPortGreybox] ServerStorage.Maps is missing: connect Rojo first")
		return
	end
	local recording = ChangeHistoryService:TryBeginRecording("BuildPortGreybox")

	local old = maps:FindFirstChild(Data.MapName)
	if old then
		old:Destroy()
	end
	local map = Instance.new("Model")
	map.Name = Data.MapName
	map:SetAttribute("DisplayName", Data.DisplayName)
	map:SetAttribute("MinPlayers", Data.MinPlayers)
	map:SetAttribute("MaxPlayers", Data.MaxPlayers)
	map:SetAttribute("InRotation", true)
	map:SetAttribute("Greybox", true)

	for _, info in Data.Parts do
		addPart(map, info)
	end
	addBoundary(map, Data.Half)
	addSpawns(map)
	map.WorldPivot = CFrame.new()
	map.Parent = maps

	if recording then
		ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
	end
	print(
		`[BuildPortGreybox] built ServerStorage.Maps.{Data.MapName}: {#Data.Parts} parts,`
			.. ` {#Data.Spawns} spawns. Playtest it from the dev panel (Maps tab > Play).`
	)
end
