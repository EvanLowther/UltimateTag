{
  "name": "UltimateTag",
  "servePort": 34874,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "Lobby": {
        "$path": "src/lobby"
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "ClockTime": 14,
        "Brightness": 2,
        "GlobalShadows": true
      }
    },
    "ServerStorage": {
      "Maps": {
        "$path": "src/maps"
      }
    }
  }
}
